{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "line-stock",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "observability": { "enabled": true },

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "line-stock",
      "database_id": "f56c04cb-1c7b-46d6-9901-6b6f5b1e2666",
      "migrations_dir": "migrations"
    }
  ],

  "vars": {
    "ENVIRONMENT": "production",
    "LINE_LOGIN_CHANNEL_ID": "2011721807",
    "LIFF_ID": "2011721807-0ePhNOYG"
  }
}
